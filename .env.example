# Copy this file to .env (the real .env is never committed).
# Which AI extractor to use: "mock" needs no API key; "llm" is planned for D3.
EXTRACTOR=mock
# Fixes "today" so the synthetic stay dates (2-5 Dec 2026) never look like the past.
DEMO_TODAY=2026-12-02
# Only needed when EXTRACTOR=llm (D3). Never commit a real key.
LLM_API_KEY=
LLM_MODEL=